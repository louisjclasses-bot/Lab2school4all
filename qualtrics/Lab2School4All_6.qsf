},{"Type":"Standard","ID":"BL_Ydg3diI33Xl6nLQ","FlowID":"FL_183","Autofill":[]},{"Type":"Standard","ID":"BL_vhGx8c3a5TEH7Z1","FlowID":"FL_184","Autofill":[]},{"Type":"Standard","ID":"BL_LfQSdFGEnuTQIj9","FlowID":"FL_185","Autofill":[]},{"Type":"Standard","ID":"BL_N8WM4rWgI2VomUe","FlowID":"FL_186","Autofill":[]},{"Type":"Standard","ID":"BL_Id4fLdOZ9Ejxau1","FlowID":"FL_187","Autofill":[]}]},{"Type":"Standard","ID":"BL_5rZtxULGcEJv8o6","FlowID":"FL_188","Autofill":[]},{"Type":"Standard","ID":"BL_GCJKJCJTGJRP6jk","FlowID":"FL_189","Autofill":[]}]}],"Properties":{"Count":189}}},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"f766370f-6215-435a-b5a6-74fda4f57379"}},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"755","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"QG","PrimaryAttribute":"QG_MHSIvo8xqipWTwh","SecondaryAttribute":"Default Quota Group","TertiaryAttribute":null,"Payload":{"ID":"QG_MHSIvo8xqipWTwh","Name":"Default Quota Group","Selected":true,"MultipleMatch":"PlaceInAll","Public":false,"Quotas":[]}},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"QGO","PrimaryAttribute":"QGO_QuotaGroupOrder","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":["QG_MHSIvo8xqipWTwh"]},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"RS","PrimaryAttribute":"RS_8197Bdmh5LMxpuC","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_9FWbXHzZGFZlENw","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"LAB2SCHOOL4ALLStakeholders Perspectives on Adapting Textbook Exercises for Children with Developmental Coordination Disorder\/Dyspraxia ","SkinLibrary":"unioflimerick","SkinType":"component","Skin":{"brandingId":null,"templateId":"*simple","overrides":{"logo":{"height":"1px","banner":true},"font":{"family":"arial, helvetica, sans-serif"},"answerText":{"size":"20px"},"layout":{"spacing":1},"question":{"displayWidth":"full"}}},"NewScoring":1,"SurveyMetaDescription":"This research explores different stakeholders\u2019 perspectives on adaptations to textbook based academic exercises for children with Developmental Coordination Disorder (DCD)\/Dyspraxia.                                                               Children with DCD\/Dyspraxia experience difficulties accessing standard academic exercises related to motor coordination (for example, handwriting) and visual-spatial processing (for example, navigating page layouts). Adaptations particularly within digital or redesigned textbooks may support participation and learning.                                                                                      \nThe purpose of this survey study is to gather feedback on examples of adapted textbook exercises and proposed adaptation ideas. Participants will be asked to review examples and rate how effective they believe each adaptation would be for a child with DCD. The findings will inform recommendations for the development of digitalised textbooks as part of a larger EU project.\n","SurveyName":"Lab2School4All","PageTransition":"none","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN-GB":[]},"QuestionsPerPage":"1","CustomStyles":{"customCSS":"\/* ========================================================\n   SUPPRESSION DU GRAND BLANC EN HAUT (TOUS TYPES DE SLIDES)\n   ======================================================== *\/\n\n\/* 1. D\u00e9sactiver le centrage vertical forc\u00e9 de Qualtrics *\/\nbody,\nhtml,\nmain,\n.survey-container,\n.page,\n.page-content,\n#page {\n  justify-content: flex-start !important;\n  align-items: flex-start !important;\n  align-content: flex-start !important;\n  padding-top: 0px !important;\n  margin-top: 0px !important;\n}\n\n\/* 2. Ancien moteur Qualtrics (Classic \/ Flat) *\/\n.Skin .SkinInner,\n.Skin #SkinContent,\n.Skin .QuestionOuter,\n.Skin .QuestionBody {\n  padding-top: 0px !important;\n  margin-top: 0px !important;\n}\n\n\/* 3. Nouveau moteur Qualtrics (Simple Layout) *\/\nsection.question,\n.question,\n.question-display-wrapper,\n.question-content,\n.overflow-container {\n  padding-top: 0px !important;\n  margin-top: 0px !important;\n}\n\n\/* 4. Masquer les en-t\u00eates et r\u00e9serves invisibles *\/\nheader,\n.header-container,\n.Skin #HeaderContainer,\n.Skin #Header,\n.Skin #LogoContainer,\n.Skin .Separator,\n.progressbar-container,\n.progress-bar-container,\n[data-testid=\"header\"] {\n  display: none !important;\n  height: 0px !important;\n  margin: 0px !important;\n  padding: 0px !important;\n}\n\n\/* 5. Questions et options de r\u00e9ponse en noir (pas de gris) *\/\n.question,\n.question *:not([class*=\"error\"]):not([class*=\"Error\"]) {\n  color: #000 !important;\n  -webkit-text-fill-color: #000 !important;\n}\n\n\/* 6. Code des comparaisons : invisible pour les participants, pr\u00e9sent dans l'export CSV *\/\n.jl-code,\n.question .jl-code {\n  display: none !important;\n}\n\n\/* ========================================================\n   AJUSTEMENT DE LA TAILLE DES ADAPTATIONS\n   ======================================================== *\/\n\n\/* Emp\u00eacher la r\u00e9duction de la largeur maximum du contenu d'une question *\/\n.question .question-display {\n  max-width: inherit;\n}\n\n\/* Forcer une largeur maximale et une hauteur minimale \u00e0 l'encadr\u00e9 des adaptations. *\/\n.question .jl-adaptation-wrap {\n  width: 100%;\n  max-width: 96vw;\n  height: calc(100vh - 120px);\n  min-height: 400px;\n  max-height: 600px;\n  overflow: hidden;\n  border: 1px solid #ccc;\n}\n\n.question .jl-adaptation-wrap > iframe {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border: 0;\n}\n\n#preview #preview-container {\n  top: 0\n}\n\n\n\/* ========================================================\n   AJUSTEMENTS SPECIFIQUES A UNE QUESTION\n   ======================================================== *\/\n\n\n\/* 1. Largeur globale de la question pour s'aligner sur l'image *\/\n[id*=\"QID101\"] {\n  width: 100% !important;\n  max-width: 1000px !important;\n  margin: 0 auto !important;\n}\n\n\/* 2. Conteneur des r\u00e9ponses (alignement horizontal moderne) *\/\n[id*=\"QID101\"] .answers-container,\n[id*=\"QID101\"] fieldset,\n[id*=\"QID101\"] [role=\"radiogroup\"],\n[id*=\"QID101\"] .answers,\n[id*=\"QID101\"] .QuestionBody {\n  display: flex !important;\n  flex-direction: row !important;\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 25px auto 0 auto !important;\n  padding: 0 !important;\n  justify-content: space-around !important;\n}\n\n\/* 3. Attribution de 50 % de largeur exacte \u00e0 chaque colonne de choix *\/\n[id*=\"QID101\"] .answers-container > *,\n[id*=\"QID101\"] .choice,\n[id*=\"QID101\"] .answer-container,\n[id*=\"QID101\"] [role=\"radiogroup\"] > div,\n[id*=\"QID101\"] [role=\"radiogroup\"] > label,\n[id*=\"QID101\"] fieldset > div {\n  flex: 1 1 50% !important;\n  width: 50% !important;\n  max-width: 50% !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  text-align: center !important;\n  box-sizing: border-box !important;\n}\n\n\n\n\/* ________________________________________________________\n   COMPARAISONS D'ADAPTATIONS (5 questions par pays)\n   France  : QID98, QID103, QID315, QID316, QID317\n   Irlande : QID463 \u00e0 QID467\n   UK      : QID607 \u00e0 QID611\n   Italie  : QID751 \u00e0 QID755\n   Pour ajouter une question, ajoutez son QID dans CHAQUE\n   liste :is(...) ci-dessous (10 endroits).\n   ________________________________________________________ *\/\n\n\/* 1. \u00c9largissement de la question sur tout l'\u00e9cran *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"]) {\n  width: 95vw !important;\n  max-width: 1200px !important;\n  position: relative !important;\n  left: 50% !important;\n  transform: translateX(-50%) !important;\n}\n\n\/* 2. D\u00e9bridage des conteneurs internes *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"])\n  :is(.overflow-container, .overflow-content, .question-content, .mc-content) {\n  overflow: visible !important;\n  width: 100% !important;\n  max-width: 100% !important;\n}\n\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"]) .shadow {\n  display: none !important;\n}\n\n\/* 3. Alignement horizontal des deux colonnes *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"]) .choices {\n  display: flex !important;\n  flex-direction: row !important;\n  justify-content: center !important;\n  gap: 28px !important;\n  width: 100% !important;\n  max-width: 100% !important;\n}\n\n\/* 4. Chaque colonne prend 50 % de l'espace disponible *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"]) .choice {\n  flex: 1 1 0 !important;\n  width: 50% !important;\n  max-width: 50% !important;\n  min-width: 0 !important;\n  box-sizing: border-box !important;\n  cursor: pointer !important;\n}\n\n\/* 5. Annulation des brides de largeur de Qualtrics sur les images *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"])\n  :is(.choice-error-container, .choice-error, .choice-label, .choice-content,\n      .display-with-image, .display-with-image-display) {\n  width: 100% !important;\n  max-width: 100% !important;\n  min-width: 0 !important;\n  display: block !important;\n  text-align: center !important;\n  cursor: pointer !important;\n}\n\n\/* 6. Masquage complet du bouton radio *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\"],\n    [id*=\"QID607\"], [id*=\"QID608\"], [id*=\"QID609\"], [id*=\"QID610\"], [id*=\"QID611\"],\n    [id*=\"QID751\"], [id*=\"QID752\"], [id*=\"QID753\"], [id*=\"QID754\"], [id*=\"QID755\"]) .radio-button {\n  display: none !important;\n}\n\n\/* 7. Format et bordure de base des images *\/\n:is([id*=\"QID98\"], [id*=\"QID103\"], [id*=\"QID315\"], [id*=\"QID316\"], [id*=\"QID317\"],\n    [id*=\"QID463\"], [id*=\"QID464\"], [id*=\"QID465\"], [id*=\"QID466\"], [id*=\"QID467\