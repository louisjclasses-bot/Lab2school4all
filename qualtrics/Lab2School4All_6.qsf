FL_162","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID615","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID615\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID615","LeftOperand":"q:\/\/QID615\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Lei risponde a questo questionario in qualit\u00e0 di:<\/span> <span class=\"LeftOpDesc\">Genitore \/ persona che si prende cura di un bambino con disprassia<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Standard","ID":"BL_1iz2ro3B9zKC04d","FlowID":"FL_163","Autofill":[]}]},{"Type":"Branch","FlowID":"FL_164","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID615","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID615\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID615","LeftOperand":"q:\/\/QID615\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Lei risponde a questo questionario in qualit\u00e0 di:<\/span> <span class=\"LeftOpDesc\">Insegnante di scuola primaria<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Standard","ID":"BL_wyU7uBmwXYlMz4P","FlowID":"FL_165","Autofill":[]}]},{"Type":"Branch","FlowID":"FL_166","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID615","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID615\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID615","LeftOperand":"q:\/\/QID615\/SelectableChoice\/3","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Lei risponde a questo questionario in qualit\u00e0 di:<\/span> <span class=\"LeftOpDesc\">Professionista sanitario (terapista della neuro e psic